# Canonical run configuration — Qwen3.5-27B from-scratch NLA.
#
# Plain KEY=value lines only (no bash expansion). Every script in this dir
# loads this file with SETDEFAULT semantics: values already in the caller's
# environment win. Point NLA_RUN_CONFIG at a different file to swap profiles
# (see smoke_7b.env for the validated small-scale profile).
#
# INJECTION_SCALE below is the MEASURED value from the 300-row bring-up on
# Qwen3.5-27B L42 (mean residual L2 = 95.6 -> suggested 115; 2026-07-05,
# tf 5.3.0 / v0.5.10.post1 stack). Re-confirm against norm_stats.json after
# the FULL extraction — if the full-run suggestion differs materially,
# update this. Never carry it to a different base model or layer.

# ── model ────────────────────────────────────────────────────────────────────
BASE_MODEL=Qwen/Qwen3.5-27B
MODEL_TAG=qwen3.5-27b-L42
LAYER_INDEX=42
D_MODEL=5120
INJECTION_SCALE=115

# ── paths / inputs ───────────────────────────────────────────────────────────
WORK=/workspace
MATRYOSHKA_DATASET=ceselder/nla-matryoshka-warmstart-sonnet46
HF_TOKEN_FILE=/root/.hf_token
WANDB_KEY_FILE=/root/.wandb_key

# ── stage-0 extraction ───────────────────────────────────────────────────────
EXTRACT_BATCH=24
EXTRACT_MAX_LEN=4096

# ── dataset build ────────────────────────────────────────────────────────────
EVAL_TARGET=5000
SPLIT_SEED=42
NLA_TRUNC_MIN_TOKENS=1
NLA_TRUNC_MAX_TOKENS=120
AR_KEEP_FULL_FRAC=0.02
AR_TRUNCATE_SEED=0

# ── SFT warm-start (per role; FSDP over SFT_GPUS) ────────────────────────────
SFT_GPUS=4
SFT_MICRO_BS=4
SFT_GLOBAL_BS=256
SFT_LR=1e-5
SFT_MIN_LR=1e-6
SFT_WARMUP=50
SFT_EPOCHS=2
ATTN_IMPL=flash_attention_2
# qwen3 mask type: prepends a user prefix so the per-message tokenization
# doesn't hit Qwen3.5's "No user query found" raise; also handles the
# unconditional <think> block. The plain 'qwen' type CRASHES on Qwen3.5.
LOSS_MASK_TYPE=qwen3

# ── RL ───────────────────────────────────────────────────────────────────────
ACTOR_GPUS=4
CRITIC_GPUS=2
ROLLOUT_GPUS=2
ACTOR_LR=1e-5
CRITIC_LR=1e-5
KL_LOSS_COEF=0.02
NLA_KL_TAPER_HALF_LIFE=40
NLA_KL_TAPER_FLOOR=0
NUM_ROLLOUT=300
SAVE_INTERVAL=50
RL_ROLLOUT_BS=64
RL_GLOBAL_BS=512
ROLLOUT_MAX_RESP=160
ROLLOUT_MAX_CTX=512

# ── tracking / publishing ────────────────────────────────────────────────────
WANDB_PROJECT=nla-qwen3.5-27b
WANDB_TEAM=octahedral-systems
# NOTE: you do not have write access to the syvb HF account — change this
# to your own HF namespace before running any upload step.
HF_REPO_PREFIX=syvb/nla-qwen3.5-27b-L42
