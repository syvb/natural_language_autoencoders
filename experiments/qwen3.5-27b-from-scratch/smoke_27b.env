# REAL-MODEL smoke profile: the full Qwen3.5-27B pipeline at production
# topology, reduced ONLY in rows and step counts. One 8x H200/B200 box.
# Usage: NLA_RUN_CONFIG=$PWD/smoke_27b.env (the driver caps SFT steps with
# --num-rollout and RL with NUM_ROLLOUT).

BASE_MODEL=Qwen/Qwen3.5-27B
MODEL_TAG=qwen3.5-27b-L42-smoke
LAYER_INDEX=42
D_MODEL=5120
# Measured at bring-up (mean L2 95.6); the full run re-confirms.
INJECTION_SCALE=115

WORK=/workspace
MATRYOSHKA_DATASET=ceselder/nla-matryoshka-warmstart-sonnet46
HF_TOKEN_FILE=/root/.hf_token
WANDB_KEY_FILE=/root/.wandb_key

# ~6k rows -> ~3k av + ~3k ar; enough for 20 SFT steps at batch 64.
EXTRACT_LIMIT=6000
EXTRACT_BATCH=16
EXTRACT_MAX_LEN=4096

EVAL_TARGET=500
SPLIT_SEED=42
NLA_TRUNC_MIN_TOKENS=1
NLA_TRUNC_MAX_TOKENS=120
AR_KEEP_FULL_FRAC=0.02
AR_TRUNCATE_SEED=0

SFT_GPUS=4
SFT_MICRO_BS=2
SFT_GLOBAL_BS=64
SFT_LR=1e-5
SFT_MIN_LR=1e-6
SFT_WARMUP=2
SFT_EPOCHS=1
ATTN_IMPL=flash_attention_2
LOSS_MASK_TYPE=qwen3

# Production topology on one 8-GPU node.
ACTOR_GPUS=4
CRITIC_GPUS=2
ROLLOUT_GPUS=2
ACTOR_LR=1e-5
CRITIC_LR=1e-5
KL_LOSS_COEF=0.02
NLA_KL_TAPER_HALF_LIFE=40
NLA_KL_TAPER_FLOOR=0
NUM_ROLLOUT=10
SAVE_INTERVAL=8
RL_ROLLOUT_BS=8
RL_GLOBAL_BS=64
ROLLOUT_MAX_RESP=160
ROLLOUT_MAX_CTX=512

WANDB_PROJECT=nla-qwen3.5-27b-smoke
WANDB_TEAM=octahedral-systems
HF_REPO_PREFIX=syvb/nla-smoke-do-not-use
