# Small-scale smoke profile: same pipeline, Qwen2.5-7B on a 4-GPU box.
# Usage: NLA_RUN_CONFIG=$PWD/smoke_7b.env bash <script>
# Validated end-to-end (see RUNBOOK.md "Smoke test" section).

BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
MODEL_TAG=qwen2.5-7b-L20-smoke
LAYER_INDEX=20
D_MODEL=3584
# Known value for Qwen2.5-7B L20 (measured mean residual norm ~125).
INJECTION_SCALE=150

WORK=/workspace
MATRYOSHKA_DATASET=ceselder/nla-matryoshka-warmstart-sonnet46
HF_TOKEN_FILE=/root/.hf_token
WANDB_KEY_FILE=/root/.wandb_key

EXTRACT_BATCH=96
EXTRACT_MAX_LEN=4096
# Smoke: only extract a slice of the source rows (0 = all).
EXTRACT_LIMIT=6000

EVAL_TARGET=500
SPLIT_SEED=42
NLA_TRUNC_MIN_TOKENS=1
NLA_TRUNC_MAX_TOKENS=120
AR_KEEP_FULL_FRAC=0.02
AR_TRUNCATE_SEED=0

SFT_GPUS=2
SFT_MICRO_BS=8
SFT_GLOBAL_BS=64
SFT_LR=1e-5
SFT_MIN_LR=1e-6
SFT_WARMUP=2
SFT_EPOCHS=1
ATTN_IMPL=flash_attention_2

ACTOR_GPUS=2
CRITIC_GPUS=1
ROLLOUT_GPUS=1
ACTOR_LR=1e-5
CRITIC_LR=1e-5
KL_LOSS_COEF=0.02
NLA_KL_TAPER_HALF_LIFE=40
NLA_KL_TAPER_FLOOR=0
NUM_ROLLOUT=12
SAVE_INTERVAL=1000
RL_ROLLOUT_BS=16
RL_GLOBAL_BS=128
ROLLOUT_MAX_RESP=160
ROLLOUT_MAX_CTX=512

WANDB_PROJECT=nla-qwen3.5-27b-smoke
WANDB_TEAM=octahedral-systems
HF_REPO_PREFIX=syvb/nla-smoke-do-not-use
